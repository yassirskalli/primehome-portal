# ============================================================
# Prime Home Portail — Variables d'environnement (stack unifiée)
# Copier ce fichier en .env et renseigner toutes les valeurs
# NE JAMAIS committer le fichier .env dans git
# ============================================================

# ── Mots de passe base de données ────────────────────────────
ERP_DB_PASSWORD=CHANGEME_mot_de_passe_erp_db
SAV_DB_PASSWORD=CHANGEME_mot_de_passe_sav_db
DEVIS_DB_PASSWORD=CHANGEME_mot_de_passe_devis_db

# ── JWT (partagé entre ERP et Devis — doivent être IDENTIQUES) ──
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
ERP_JWT_SECRET=CHANGEME_minimum_32_caracteres_secret_aleatoire
SAV_SECRET_KEY=CHANGEME_minimum_32_caracteres_secret_aleatoire_sav
DEVIS_JWT_SECRET=CHANGEME_utiliser_la_meme_valeur_que_ERP_JWT_SECRET

# ── Odoo Production (lecture seule) ──────────────────────────
ODOO_URL=https://odoo.primehome.ma
ODOO_DB=odoo
ODOO_USER=erp_readonly@primehome.ma
ODOO_PASSWORD=CHANGEME_mot_de_passe_odoo

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://erp.primehome.ma

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sav@primehome.ma
SMTP_PASSWORD=CHANGEME_mot_de_passe_smtp
